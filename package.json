{
  "name": "nextchat",
  "private": false,
  "license": "mit",
  "scripts": {
    "mask": "npx tsx app/masks/build.ts",
    "mask:watch": "npx watch \"yarn mask\" app/masks",
    "dev": "concurrently -r \"yarn run mask:watch\" \"next dev -p 3456\"",
    "build": "yarn mask && cross-env BUILD_MODE=standalone next build",
    "start": "next start",
    "lint": "next lint",
    "export": "yarn mask && cross-env BUILD_MODE=export BUILD_APP=1 next build",
    "export:dev": "concurrently -r \"yarn mask:watch\"  \"cross-env BUILD_MODE=export BUILD_APP=1 next dev\"",
    "app:dev": "concurrently -r \"yarn mask:watch\" \"yarn tauri dev\"",
    "app:build": "yarn mask && yarn tauri build",
    "app:clear": "yarn tauri dev",
    "prompts": "node ./scripts/fetch-prompts.mjs",
    "prepare": "husky",
    "proxy-dev": "sh ./scripts/init-proxy.sh && proxychains -f ./scripts/proxychains.conf yarn dev",
    "test": "node --no-warnings --experimental-vm-modules $(yarn bin jest) --watch",
    "test:ci": "node --no-warnings --experimental-vm-modules $(yarn bin jest) --ci"
  },
  "dependencies": {
    "@fortaine/fetch-event-source": "^3.0.6",
    "@hello-pangea/dnd": "^18.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@next/third-parties": "^16.3.0",
    "@svgr/webpack": "^6.5.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "fuse.js": "^7.5.0",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "lodash-es": "^4.18.1",
    "markdown-to-txt": "^2.0.1",
    "mermaid": "^10.9.8",
    "nanoid": "^5.1.16",
    "next": "14.2.35",
    "node-fetch": "^3.3.2",
    "openapi-client-axios": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rt-client": "https://github.com/Azure-Samples/aoai-realtime-audio-sdk/releases/download/js/v0.5.0/rt-client-0.5.0.tgz",
    "sass": "^1.102.0",
    "spark-md5": "^3.0.2",
    "use-debounce": "^10.1.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "1.6.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-katex": "^3.0.4",
    "@types/spark-md5": "^3.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "13.5.11",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "watch": "^1.0.2",
    "webpack": "^5.109.2"
  },
  "resolutions": {
    "lint-staged/yaml": "^2.2.2"
  },
  "packageManager": "yarn@1.22.22"
}
